PREFIX : <http://www.semanticweb.org/jaspe/ontologies/2026/0/combined-ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

# queries to write for:

# information gathered from title of executable (will have to do string parsing for this)
    # optimization level
    # obfuscation (0 for false, 1 for true)
    # if file is stripped (true or false)
# semantic graph stuff
        # number of distinct flags found in executable
# name: distinctSecurityFlagsCount
SELECT (COUNT(DISTINCT ?flag) AS ?distinctSecurityFlagsCount)
WHERE {
    ?function :hasSecurityFlag ?flag .
}

# number of functions with at least one security flag
# name: fractionOfFunctionsWithFlags
SELECT (?flagFuncs / ?totalFuncs AS ?fractionOfFunctionsWithFlags)
WHERE {
    # first, count distinct functions that have at least one security flag
    {
        SELECT (COUNT(DISTINCT ?func) AS ?flagFuncs)
        WHERE {
            ?func :hasSecurityFlag ?flag .
            FILTER NOT EXISTS { ?func rdf:type :ExternalFunctionNode }
        }
    }
    # then, get the count of the total number of functions in the binary
    {
        SELECT (COUNT(?total) AS ?totalFuncs)
        WHERE {
            ?total rdf:type :FunctionNode .
            FILTER NOT EXISTS { ?total rdf:type :ExternalFunctionNode }
        }
    }
}

# Risk levels
# # of functions with low security level
# name: lowRiskFunctionCount
SELECT (COUNT(?function) AS ?lowRiskFunctionCount)
WHERE {
    ?function rdf:type :FunctionNode ;
              :hasRiskLevel "LOW" .
}
# # of functions with medium security level
# name: mediumRiskFunctionCount
SELECT (COUNT(?function) AS ?mediumRiskFunctionCount)
WHERE {
    ?function rdf:type :FunctionNode ;
              :hasRiskLevel "MEDIUM" .
}
# # of functions with high security level
# name: highRiskFunctionCount
SELECT (COUNT(?function) AS ?highRiskFunctionCount)
WHERE {
    ?function rdf:type :FunctionNode ;
              :hasRiskLevel "HIGH" .
}
    
# graph structure
# number of functions
# name: totalFunctionCount
SELECT (COUNT(DISTINCT ?functionNode) AS ?totalFunctionCount)
WHERE {
    # internal and external functions together (external nodes are not always typed as FunctionNode)
    { ?functionNode rdf:type :FunctionNode . }
    UNION
    { ?functionNode rdf:type :ExternalFunctionNode . }
}

# # of just internal functions
# name: internalFunctionCount
SELECT (COUNT(?functionNode) AS ?internalFunctionCount)
WHERE {
    ?functionNode rdf:type :FunctionNode .
    FILTER NOT EXISTS { ?functionNode rdf:type :ExternalFunctionNode }
}

# # of external functions:
# name: externalFunctionCount
SELECT (COUNT(?externalNode) AS ?externalFunctionCount)
WHERE {
    ?externalNode rdf:type :ExternalFunctionNode .
}

# number of communities
# name: uniqueCommunityCount
SELECT (COUNT(DISTINCT ?community) AS ?uniqueCommunityCount)
WHERE {
    ?function :belongsToCommunity ?community .
}

# fraction of functions that call external functions
# name: externalFunctionCallFraction
SELECT (?externalCallingFuncs / ?totalFuncs AS ?externalFunctionCallFraction)
WHERE {
    # first, count distinct functions that call an external function
    {
        SELECT (COUNT(DISTINCT ?func) AS ?externalCallingFuncs)
        WHERE {
            ?func :calls ?extFunc .
            ?extFunc rdf:type :ExternalFunctionNode .
            # the caller must be an internal function (external nodes also have :calls edges)
            FILTER NOT EXISTS { ?func rdf:type :ExternalFunctionNode }
        }
    }
    # then, get the count of the total number of functions in the binary
    {
        SELECT (COUNT(?total) AS ?totalFuncs)
        WHERE {
            ?total rdf:type :FunctionNode .
            FILTER NOT EXISTS { ?total rdf:type :ExternalFunctionNode }
        }
    }
}
# number of instances of the following edges
# removed taintFlowsTom and networkRecv from this section since they produced no output
#
# calls vulnerable
# name: callsVulnerableCount
SELECT (COUNT(*) AS ?callsVulnerableCount)
WHERE {
    ?subject :callsVulnerable ?object .
}

# other
# instances of hasFileIOAPI relations
# name: hasFileIOAPICount
SELECT (COUNT(*) AS ?hasFileIOAPICount)
WHERE {
    ?subject :hasFileIOAPI ?object .
}
# instances of hasNetworkAPI relations
# name: hasNetworkAPICount
SELECT (COUNT(*) AS ?hasNetworkAPICount)
WHERE {
    ?subject :hasNetworkAPI ?object .
}

# instances of hasFilePath relations
# name: hasFilePathCount
SELECT (COUNT(*) AS ?hasFilePathCount)
WHERE {
    ?subject :hasFilePath ?object .
}

# ==================== individual api instances ====================
# Networking APIs:
# name: socketApiCount
SELECT (COUNT(?caller) AS ?socketApiCount)
WHERE {
    ?caller :calls ?extFunc .
    ?extFunc rdf:type :ExternalFunctionNode .
    FILTER(LCASE(STRAFTER(STR(?extFunc), "#")) IN ("socket"))
    FILTER NOT EXISTS { ?caller rdf:type :ExternalFunctionNode }
}

# name: connectApiCount
SELECT (COUNT(?extFunc) AS ?connectApiCount)
WHERE {
    ?extFunc rdf:type :ExternalFunctionNode .
    FILTER(LCASE(STRAFTER(STR(?extFunc), "#")) IN ("connect"))
}

# name: bindApiCount
SELECT (COUNT(?extFunc) AS ?bindApiCount)
WHERE {
    ?extFunc rdf:type :ExternalFunctionNode .
    FILTER(LCASE(STRAFTER(STR(?extFunc), "#")) IN ("bind"))
}

